# Papéis do processo: api, consumer, workers (separados por vírgula). Padrão: todos.
ROLES=api,consumer,workers
PORT=3000

DATABASE_URL=postgres://wager:wager@localhost:5433/wager

# SQS (LocalStack)
LOCALSTACK_AUTH_TOKEN=seu_token_aqui
AWS_REGION=us-east-1
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_TRANSACTIONS_QUEUE=wager-transactions.fifo
SQS_TRANSACTIONS_DLQ=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE=wager-events.fifo

# Concorrência e reprocessamento
LOCK_TIMEOUT_MS=5000
PENDING_REFERENCE_TTL_SECONDS=3600
PENDING_REFERENCE_BACKOFF_BASE_SECONDS=5
PENDING_REFERENCE_BACKOFF_MAX_SECONDS=300

# Gancho de falha, SOMENTE para testes (desligado por padrão)
# FAULT=crash_after_commit
