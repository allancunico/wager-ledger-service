{
  "name": "wager-ledger-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Serviço financeiro distribuído para transações de apostas (Bun + NestJS + MikroORM + PostgreSQL + SQS)",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "infra:up": "docker compose up -d --wait postgres localstack",
    "infra:down": "docker compose down -v",
    "migrate:up": "bun run src/infrastructure/database/migrate.ts up",
    "migrate:down": "bun run src/infrastructure/database/migrate.ts down",
    "test:unit": "bun test test/unit",
    "test:integration": "bun test test/integration",
    "test:concurrency": "bun test test/concurrency",
    "spike": "bun run spike/run.ts"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1176.0",
    "@mikro-orm/core": "^7.2.11",
    "@mikro-orm/migrations": "^7.2.11",
    "@mikro-orm/postgresql": "^7.2.11",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/platform-express": "^12.6.0",
    "decimal.js": "^10.6.0",
    "nestjs-pino": "^5.3.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "@types/bun": "^1.4.5",
    "@types/express": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "typescript": "^7.0.2"
  }
}
